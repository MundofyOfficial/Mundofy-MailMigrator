<Window x:Class="Mundofy.MailMigrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Mundofy.MailMigrator.App.ViewModels"
        xmlns:models="clr-namespace:Mundofy.MailMigrator.Core.Models;assembly=Mundofy.MailMigrator.Core"
        mc:Ignorable="d"
        Title="Mundofy MailMigrator — High-Speed IMAP &amp; POP3 Migration Suite" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="800" Width="1140"
        MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">
    
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BRAND HEADER -->
        <Border Grid.Row="0" Background="#0B1329" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- OFFICIAL MUNDOFY LOGO MARK -->
                    <Image Source="pack://application:,,,/Assets/mundofy_mark_color.png" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Width="34" Height="34" 
                           Margin="0,0,14,0" 
                           VerticalAlignment="Center" />
                    
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mundofy MailMigrator" FontWeight="Bold" FontSize="20" Foreground="#FFFFFF" />
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.3.0" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" />
                            </Border>

                            <!-- In-App Update Notification Badge -->
                            <Button Command="{Binding OpenUpdateDialogCommand}"
                                    Cursor="Hand"
                                    Margin="12,0,0,0"
                                    ToolTip="A newer version of Mundofy MailMigrator is available on GitHub. Click to update now.">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="badgeBorder"
                                                            Background="#065F46"
                                                            BorderBrush="#10B981"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Padding="10,3"
                                                            SnapsToDevicePixels="True">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="badgeIcon" Text="⚡ Update Available: " FontSize="11" FontWeight="Bold" Foreground="#6EE7B7" />
                                                            <TextBlock Text="{Binding LatestVersion, StringFormat={}v{0}}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            <TextBlock x:Name="badgeAction" Text=" (Update Now)" FontSize="10" Foreground="#A7F3D0" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="badgeBorder" Property="Background" Value="#047857" />
                                                            <Setter TargetName="badgeBorder" Property="BorderBrush" Value="#34D399" />
                                                            <Setter TargetName="badgeIcon" Property="Foreground" Value="#A7F3D0" />
                                                            <Setter TargetName="badgeAction" Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="badgeBorder" Property="Background" Value="#064E3B" />
                                                            <Setter TargetName="badgeBorder" Property="BorderBrush" Value="#059669" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Modern High-Speed IMAP &amp; POP3 Email Migration Suite | Free for Everyone" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <Run Text="Created by Danny Schuller  •  " />
                        <Hyperlink NavigateUri="https://mundofy.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA" TextDecorations="None">
                            mundofy.com
                        </Hyperlink>
                        <Run Text="  •  " />
                        <Hyperlink NavigateUri="https://github.com/MundofyOfficial/Mundofy-MailMigrator/issues" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#93C5FD" TextDecorations="Underline">
                            Report an Issue
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="18,12,18,18">
            
            <!-- TAB 1: SINGLE MAILBOX MIGRATION -->
            <TabItem Header="Single Account Migration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- SOURCE CARD -->
                            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Source Mailbox (From)" FontWeight="Bold" FontSize="15" Foreground="#60A5FA" Margin="0,0,0,14" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Protocol" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                            <ComboBox SelectedValue="{Binding SingleSourceProtocol, Mode=TwoWay}" SelectedValuePath="Tag" Height="38" IsEnabled="{Binding IsNotSingleMigrating}">
                                                <ComboBoxItem Content="IMAP (Recommended)" Tag="{x:Static models:ServerProtocol.Imap}" IsSelected="True" />
                                                <ComboBoxItem Content="POP3" Tag="{x:Static models:ServerProtocol.Pop3}" />
                                                <ComboBoxItem Content="Microsoft 365 (Graph API) — Coming Soon" Tag="{x:Static models:ServerProtocol.Microsoft365}" IsEnabled="False" ToolTip="Modern OAuth2 &amp; Microsoft Graph API authentication is under construction." />
                                                <ComboBoxItem Content="Google Workspace (Gmail API) — Coming Soon" Tag="{x:Static models:ServerProtocol.GoogleWorkspace}" IsEnabled="False" ToolTip="Google Service Account &amp; Gmail API authentication is under construction." />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                            <TextBox Text="{Binding SingleSourcePort, UpdateSourceTrigger=PropertyChanged}" Height="38" IsEnabled="{Binding IsNotSingleMigrating}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Server Host / Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right" Content="⚡ Auto-Detect" Command="{Binding AutoDetectSingleSourceCommand}" Cursor="Hand" Padding="8,2" FontSize="11" Height="22" Background="#1E293B" BorderBrush="#334155" Foreground="#60A5FA" ToolTip="Automatically detect IMAP server settings from email address" />
                                    </Grid>
                                    <TextBox Text="{Binding SingleSourceHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <CheckBox Content="Use SSL/TLS Encryption" IsChecked="{Binding SingleSourceUseSsl}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <TextBlock Text="Username / Email Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding SingleSourceUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <TextBlock Text="Password / App Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding SingleSourcePassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Test Source Connection" Command="{Binding TestSingleSourceCommand}" Padding="18,8" />
                                        <TextBlock Grid.Column="1" Text="{Binding SingleSourceStatus}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- Single Source Mailbox Quota Info -->
                                    <Border Margin="0,12,0,0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SingleSourceQuota}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📊 Storage Quota:" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SingleSourceQuota.FormattedSummary}" Foreground="{Binding SingleSourceQuota, Converter={StaticResource QuotaStatusToBrushConverter}}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- DESTINATION CARD -->
                            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Destination Mailbox (To)" FontWeight="Bold" FontSize="15" Foreground="#34D399" Margin="0,0,0,14" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Protocol" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                            <ComboBox SelectedValue="{Binding SingleDestProtocol, Mode=TwoWay}" SelectedValuePath="Tag" Height="38" IsEnabled="{Binding IsNotSingleMigrating}">
                                                <ComboBoxItem Content="IMAP (Standard / cPanel)" Tag="{x:Static models:ServerProtocol.Imap}" IsSelected="True" />
                                                <ComboBoxItem Content="Microsoft 365 (Graph API) — Coming Soon" Tag="{x:Static models:ServerProtocol.Microsoft365}" IsEnabled="False" ToolTip="Direct Microsoft Graph mailbox injection without user passwords is under construction." />
                                                <ComboBoxItem Content="Google Workspace (Gmail API) — Coming Soon" Tag="{x:Static models:ServerProtocol.GoogleWorkspace}" IsEnabled="False" ToolTip="Google Domain-Wide Delegation &amp; Gmail API migration without user passwords is under construction." />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                            <TextBox Text="{Binding SingleDestPort, UpdateSourceTrigger=PropertyChanged}" Height="38" IsEnabled="{Binding IsNotSingleMigrating}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Server Host / Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right" Content="⚡ Auto-Detect" Command="{Binding AutoDetectSingleDestCommand}" Cursor="Hand" Padding="8,2" FontSize="11" Height="22" Background="#1E293B" BorderBrush="#334155" Foreground="#34D399" ToolTip="Automatically detect IMAP server settings from email address" />
                                    </Grid>
                                    <TextBox Text="{Binding SingleDestHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <CheckBox Content="Use SSL/TLS Encryption" IsChecked="{Binding SingleDestUseSsl}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <TextBlock Text="Username / Email Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding SingleDestUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <TextBlock Text="Password / App Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding SingleDestPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" IsEnabled="{Binding IsNotSingleMigrating}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Test Dest Connection" Command="{Binding TestSingleDestCommand}" Padding="18,8" />
                                        <TextBlock Grid.Column="1" Text="{Binding SingleDestStatus}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- Single Dest Mailbox Quota Info -->
                                    <Border Margin="0,12,0,0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SingleDestQuota}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📊 Storage Quota:" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SingleDestQuota.FormattedSummary}" Foreground="{Binding SingleDestQuota, Converter={StaticResource QuotaStatusToBrushConverter}}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- SINGLE MIGRATION ACTIONS & PROGRESS -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Migration Progress" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding SingleJob.StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    
                                    <!-- PROMINENT BUTTONS WITH GENEROUS PADDING & ICONS -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartSingleMigrationCommand}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="▶" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="Start Migration" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelSingleMigrationCommand}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⏹" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Value="{Binding SingleJob.ProgressPercentage, Mode=OneWay}" Maximum="100" Height="14" Margin="0,0,0,16" />

                                <!-- Metrics Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Current Folder" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SingleJob.CurrentFolder, FallbackValue='—'}" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="New Copied" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SingleJob.CopiedMessages, Mode=OneWay}" Margin="0,4,0,0" FontWeight="Bold" FontSize="14" Foreground="#34D399" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Already on Dest" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SingleJob.SkippedMessages, Mode=OneWay}" Margin="0,4,0,0" FontWeight="Bold" FontSize="14" Foreground="#60A5FA" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#0F172A" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Speed" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SingleJob.TransferSpeed, FallbackValue='0.0 MB/s'}" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0" Foreground="#FBBF24" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Background="#0F172A" CornerRadius="6" Padding="12" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Errors / Total" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" FontSize="13">
                                                <Run Text="{Binding SingleJob.FailedMessages, Mode=OneWay}" Foreground="#F87171" />
                                                <Run Text=" / " Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text="{Binding SingleJob.TotalMessages, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: BATCH MIGRATION -->
            <TabItem Header="Batch Migration (Multi-Account)">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: DEFAULT SERVERS & CONCURRENCY SETTING -->
                    <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2.0*" />
                            </Grid.ColumnDefinitions>

                            <!-- DEFAULT SOURCE -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Default Source Server" FontWeight="SemiBold" FontSize="13" Foreground="#60A5FA" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Content="⚡ Auto-Detect" Command="{Binding AutoDetectBatchSourceCommand}" Cursor="Hand" Padding="6,1" FontSize="10" Height="20" Background="#1E293B" BorderBrush="#334155" Foreground="#60A5FA" ToolTip="Auto-detect source server from domain or first account" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" SelectedValue="{Binding BatchSourceProtocol, Mode=TwoWay}" SelectedValuePath="Tag" ToolTip="Source Protocol / Provider" IsEnabled="{Binding IsNotBatchRunning}">
                                        <ComboBoxItem Content="IMAP" Tag="{x:Static models:ServerProtocol.Imap}" IsSelected="True" />
                                        <ComboBoxItem Content="POP3" Tag="{x:Static models:ServerProtocol.Pop3}" />
                                        <ComboBoxItem Content="Microsoft 365 (Graph API) — Coming Soon" Tag="{x:Static models:ServerProtocol.Microsoft365}" IsEnabled="False" ToolTip="Modern OAuth2 &amp; Microsoft Graph API authentication is under construction." />
                                        <ComboBoxItem Content="Google Workspace (Gmail API) — Coming Soon" Tag="{x:Static models:ServerProtocol.GoogleWorkspace}" IsEnabled="False" ToolTip="Google Service Account &amp; Gmail API authentication is under construction." />
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding BatchSourceHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="Source Host (e.g. mail.oldserver.com)" IsEnabled="{Binding IsNotBatchRunning}" />
                                    <TextBox Grid.Column="4" Text="{Binding BatchSourcePort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port (e.g. 993 for IMAP, 995 for POP3)" IsEnabled="{Binding IsNotBatchRunning}" />
                                </Grid>
                            </StackPanel>

                            <!-- DEFAULT DEST -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Default Destination Server" FontWeight="SemiBold" FontSize="13" Foreground="#34D399" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Content="⚡ Auto-Detect" Command="{Binding AutoDetectBatchDestCommand}" Cursor="Hand" Padding="6,1" FontSize="10" Height="20" Background="#1E293B" BorderBrush="#334155" Foreground="#34D399" ToolTip="Auto-detect destination server from domain or first account" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" SelectedValue="{Binding BatchDestProtocol, Mode=TwoWay}" SelectedValuePath="Tag" ToolTip="Destination Protocol / Provider" IsEnabled="{Binding IsNotBatchRunning}">
                                        <ComboBoxItem Content="IMAP" Tag="{x:Static models:ServerProtocol.Imap}" IsSelected="True" />
                                        <ComboBoxItem Content="Microsoft 365 (Graph API) — Coming Soon" Tag="{x:Static models:ServerProtocol.Microsoft365}" IsEnabled="False" ToolTip="Direct Microsoft Graph mailbox injection without user passwords is under construction." />
                                        <ComboBoxItem Content="Google Workspace (Gmail API) — Coming Soon" Tag="{x:Static models:ServerProtocol.GoogleWorkspace}" IsEnabled="False" ToolTip="Google Domain-Wide Delegation &amp; Gmail API migration without user passwords is under construction." />
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding BatchDestHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="Dest Host (e.g. imap.newserver.com)" IsEnabled="{Binding IsNotBatchRunning}" />
                                    <TextBox Grid.Column="4" Text="{Binding BatchDestPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port (e.g. 993)" IsEnabled="{Binding IsNotBatchRunning}" />
                                </Grid>
                            </StackPanel>

                            <!-- CONCURRENCY SETTING -->
                            <StackPanel Grid.Column="4">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Concurrent Workers:" FontWeight="SemiBold" FontSize="13" Foreground="#FBBF24" />
                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{Binding Concurrency}" FontWeight="Bold" FontSize="12" Foreground="#FBBF24" />
                                    </Border>
                                </Grid>
                                <Slider Minimum="1" Maximum="16" Value="{Binding Concurrency}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" IsEnabled="{Binding IsNotBatchRunning}" />
                                <TextBlock Text="How many accounts migrate at once" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 1: BATCH TOOLBAR -->
                    <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button Content="➕ Add Account" Command="{Binding AddAccountCommand}" Margin="0,0,8,0" Padding="14,8" />
                                <Button Content="➖ Remove Selected" Command="{Binding RemoveAccountCommand}" Margin="0,0,8,0" Padding="14,8" ToolTip="Delete the currently selected account row (or press Delete key)" />
                                <Button Content="📋 Paste Clipboard" Command="{Binding PasteFromClipboardCommand}" Margin="0,0,8,0" Padding="14,8" ToolTip="Paste TSV/CSV rows directly from clipboard" />
                                <Button Content="📂 Load ImapCopy.cfg" Command="{Binding LoadCfgCommand}" Margin="0,0,8,0" Padding="14,8" ToolTip="Import accounts and servers from legacy ImapCopy.cfg" />
                                <Button Content="📄 Import CSV" Command="{Binding ImportCsvCommand}" Margin="0,0,8,0" Padding="14,8" />
                                <Button Content="💾 Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" Padding="14,8" />
                                <Button Content="🗑 Clear All" Command="{Binding ClearBatchCommand}" Margin="0,0,8,0" Padding="14,8" ToolTip="Clear entire accounts table" />
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding TogglePasswordMaskCommand}" 
                                        Padding="14,8" 
                                        Margin="0,0,8,0"
                                        ToolTip="Toggle password visibility (show or mask passwords with bullets in the table)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👁" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Show Passwords" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MaskPasswords}" Value="False">
                                                            <Setter Property="Text" Value="Hide Passwords" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                 <Button Content="📊 Check Quotas" Command="{Binding CheckBatchQuotasCommand}" Margin="0,0,8,0" Padding="14,8" ToolTip="Query IMAP and POP3 storage limits and mailbox usage for all accounts" />
                                 <Button Content="🔍 Test All Credentials" Command="{Binding TestAllBatchCommand}" Padding="16,8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 2: INTERACTIVE ACCOUNTS DATAGRID -->
                    <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <DataGrid x:Name="BatchGrid"
                                  ItemsSource="{Binding BatchAccounts}" 
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="True"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  Background="Transparent"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#334155"
                                  BorderThickness="0"
                                  HeadersVisibility="Column"
                                  ColumnHeaderHeight="38"
                                  RowHeight="36">

                            <DataGrid.Resources>
                                <!-- Override system highlight brushes so WPF never paints native Win32/Aero white highlights -->
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />

                                <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Style>
                            </DataGrid.Resources>
                            
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="▶ Start / Queue / Pause Account" Command="{Binding QueueSelectedAccountCommand}" ToolTip="Start migrating, pause active, or queue into running batch" />
                                    <MenuItem Header="🔍 Test Account Credentials" Command="{Binding TestSelectedAccountCommand}" ToolTip="Test IMAP connection for this account" />
                                    <MenuItem Header="📊 Check Account Quotas" Command="{Binding CheckSelectedAccountQuotaCommand}" ToolTip="Query storage quota for this account" />
                                    <Separator />
                                    <MenuItem Header="📋 Copy Source Email" Command="{Binding CopySourceEmailCommand}" />
                                    <MenuItem Header="📋 Copy Destination Email" Command="{Binding CopyDestEmailCommand}" />
                                    <Separator />
                                    <MenuItem Header="🗑 Remove Account" Command="{Binding RemoveAccountCommand}" ToolTip="Remove selected account" />
                                    <MenuItem Header="🧹 Clear Completed Accounts" Command="{Binding ClearCompletedAccountsCommand}" ToolTip="Remove finished accounts from list" />
                                    <MenuItem Header="⚠️ Clear Entire Batch" Command="{Binding ClearBatchCommand}" ToolTip="Clear all accounts from batch" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnDataGridRowPreviewMouseRightButtonDown" />
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#182234" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#25354C" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E3A5F" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#23456F" />
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <!-- Source User -->
                                <DataGridTextColumn Header="Source User / Email" Binding="{Binding SourceUser, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DataGridTextStyle}" Width="1.8*" />

                                <!-- Source Password -->
                                <DataGridTemplateColumn Header="Source Password" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource DataGridTextStyle}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource PasswordMaskConverter}">
                                                        <Binding Path="SourcePassword" />
                                                        <Binding Path="DataContext.MaskPasswords" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SourcePassword, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="#0F172A" 
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource AccentPrimaryBrush}"
                                                     Padding="4,2" 
                                                     VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dest User -->
                                <DataGridTextColumn Header="Dest User / Email" Binding="{Binding DestUser, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DataGridTextStyle}" Width="1.8*" />

                                <!-- Dest Password -->
                                <DataGridTemplateColumn Header="Dest Password" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource DataGridTextStyle}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource PasswordMaskConverter}">
                                                        <Binding Path="DestPassword" />
                                                        <Binding Path="DataContext.MaskPasswords" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DestPassword, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="#0F172A" 
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource AccentPrimaryBrush}"
                                                     Padding="4,2" 
                                                     VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Badge -->
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Progress Bar -->
                                <DataGridTemplateColumn Header="Progress" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="8,0">
                                                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="10" />
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Messages Column -->
                                <DataGridTemplateColumn Header="Messages" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontSize="12">
                                                <Run Text="{Binding CopiedMessages, Mode=OneWay}" Foreground="#34D399" FontWeight="SemiBold" />
                                                <Run Text=" new" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text="{Binding SkippedMessages, Mode=OneWay}" Foreground="#60A5FA" />
                                                <Run Text=" exist) / " Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text="{Binding TotalMessages, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quota Column -->
                                <DataGridTemplateColumn Header="Quota (Src / Dst)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceQuota}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Src: " Foreground="#94A3B8" FontWeight="SemiBold" />
                                                    <Run Text="{Binding SourceQuota.FormattedSummary, Mode=OneWay}" Foreground="{Binding SourceQuota, Converter={StaticResource QuotaStatusToBrushConverter}}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DestQuota}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Dst: " Foreground="#94A3B8" FontWeight="SemiBold" />
                                                    <Run Text="{Binding DestQuota.FormattedSummary, Mode=OneWay}" Foreground="{Binding DestQuota, Converter={StaticResource QuotaStatusToBrushConverter}}" />
                                                </TextBlock>
                                                <TextBlock Text="—" FontSize="11" Foreground="#475569" Margin="2,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding SourceQuota}" Value="{x:Null}" />
                                                                        <Condition Binding="{Binding DestQuota}" Value="{x:Null}" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Speed -->
                                <DataGridTextColumn Header="Speed" Binding="{Binding TransferSpeed, Mode=OneWay}" ElementStyle="{StaticResource DataGridTextStyle}" Width="90" IsReadOnly="True" />

                                <!-- Details -->
                                <DataGridTextColumn Header="Details" Binding="{Binding StatusMessage, Mode=OneWay}" ElementStyle="{StaticResource DataGridTextStyle}" Width="2*" IsReadOnly="True" />

                                 <!-- Action Buttons -->
                                <DataGridTemplateColumn Header="Action" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.StartSingleAccountInBatchCommand, ElementName=BatchGrid}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        FontSize="13" 
                                                        Cursor="Hand"
                                                        Padding="4,2" 
                                                        Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="▶" />
                                                            <Setter Property="Foreground" Value="#34D399" />
                                                            <Setter Property="ToolTip" Value="Start or Queue into running batch" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:MigrationStatus.InProgress}">
                                                                    <Setter Property="Content" Value="⏸" />
                                                                    <Setter Property="Foreground" Value="#FBBF24" />
                                                                    <Setter Property="ToolTip" Value="Pause this migration" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:MigrationStatus.Paused}">
                                                                    <Setter Property="Content" Value="▶" />
                                                                    <Setter Property="Foreground" Value="#34D399" />
                                                                    <Setter Property="ToolTip" Value="Resume migration" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🗑" 
                                                        Command="{Binding DataContext.DeleteAccountRowCommand, ElementName=BatchGrid}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Foreground="#F87171" 
                                                        FontSize="13" 
                                                        Cursor="Hand"
                                                        ToolTip="Remove this account"
                                                        Padding="4,2" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ROW 3: BATCH BOTTOM ACTION & STATS -->
                    <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BatchStatusText}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                <ProgressBar Value="{Binding BatchOverallProgress, Mode=OneWay}" Maximum="100" Height="14" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartBatchCommand}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▶" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Start Batch Migration" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding StopBatchCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏹" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Stop All" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS & LOGS -->
            <TabItem Header="Settings &amp; Logs">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Margin="0,14,0,0">
                        <!-- DATE RANGE FILTER CARD -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Date Range Filter (DD-MM-YYYY)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Filter emails by sent/received date envelope (early scan skip, avoids unnecessary downloads)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Enable Date Filter" IsChecked="{Binding EnableDateFilter}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Quick Preset" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedDatePreset}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Start Date (DD-MM-YYYY)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding SinceDateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Migrate emails received on or after this date. Format: DD-MM-YYYY (e.g. 01-01-2025)" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="End Date (DD-MM-YYYY)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding BeforeDateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Migrate emails received on or before this date (leave blank for no end date). Format: DD-MM-YYYY (e.g. 31-12-2025)" />
                                    </StackPanel>
                                </Grid>

                                <!-- Validation Hint -->
                                <TextBlock Text="{Binding DateFilterValidationMessage}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- ADVANCED SETTINGS CARD -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Advanced Migration Preferences" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,12" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="Deduplicate Messages (Skip existing Message-IDs)" IsChecked="{Binding Deduplicate}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                        <CheckBox Content="Permit Self-Signed / Invalid SSL Certificates" IsChecked="{Binding AllowInvalidCertificates}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                        <CheckBox Content="Prevent Computer Sleep During Migration" IsChecked="{Binding PreventSleepDuringMigration}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" ToolTip="Keeps the PC awake while emails are actively transferring so Windows sleep mode won't interrupt connections (monitors can still turn off)." />
                                        
                                        <TextBlock Text="Destination Root Folder (Optional prefix)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding DstRootFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Copies under this folder instead of root (e.g. 'OldMails')" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Folders to Skip (comma separated)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding SkipFolders, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                        <TextBlock Text="Deny Flags (space separated, e.g. \Recent)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding DenyFlags, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- IN-APP UPDATES & RELEASES ROW -->
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Software Updates" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                                            <TextBlock Text="Check GitHub for newer versions of Mundofy MailMigrator with seamless 1-click in-place update." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}" Padding="14,6" FontSize="12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Check for Updates" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- LIVE LOGS VIEWER -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Live Activity Log" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LogCountStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Log Search Filter Box -->
                                        <Grid Width="220" Margin="0,0,8,0">
                                            <TextBox Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12"
                                                     Padding="26,5,22,5"
                                                     ToolTip="Search &amp; filter logs by message, status level, or time" />
                                            <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                                            <Button Command="{Binding ClearLogSearchCommand}"
                                                    Content="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Cursor="Hand" Padding="3,1"
                                                    Visibility="{Binding HasLogSearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Clear search filter" />
                                        </Grid>

                                        <!-- Export Logs Button -->
                                        <Button Content="💾 Export Logs" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0" Padding="12,6" FontSize="12"
                                                ToolTip="Export logs to a .TXT file or .CSV spreadsheet" />

                                        <!-- Clear Logs Button -->
                                        <Button Content="🗑 Clear Logs" Command="{Binding ClearLogsCommand}" Padding="12,6" FontSize="12"
                                                ToolTip="Clear activity logs" />
                                    </StackPanel>
                                </Grid>

                                <ListBox Grid.Row="1" 
                                         ItemsSource="{Binding FilteredLogs}" 
                                         Height="460"
                                         Background="#0F172A" 
                                         BorderBrush="{StaticResource CardBorderBrush}" 
                                         BorderThickness="1" 
                                         Padding="8,8,14,8"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseWheel="LogListBox_PreviewMouseWheel">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: ABOUT -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="32" Margin="0,14,0,0">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <!-- OFFICIAL MUNDOFY LOGO MARK ON ABOUT SCREEN -->
                                <Image Source="pack://application:,,,/Assets/mundofy_mark_color.png" 
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Width="56" Height="56" 
                                       Margin="0,0,20,0" 
                                       VerticalAlignment="Center" />
                                
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mundofy MailMigrator" FontWeight="Bold" FontSize="24" Foreground="#FFFFFF" />
                                    <TextBlock Text="Version 1.2.2" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- ORIGIN STORY CARD -->
                            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Why This Tool Was Created" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,6" />
                                    <TextBlock Text="As a managed hosting provider, we routinely help customers migrate their mailboxes to our servers. Moving email can be technically intimidating, and most users lack the specialized knowledge or tools to do it themselves safely without risking lost messages or downtime. For years, Armin Diehl's classic 'imapcopy' tool was the go-to utility. But as modern servers enforced TLS 1.3 and dropped older protocols, imapcopy began failing on TLS handshakes."
                                               TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Patching an outdated utility was no longer the smartest way forward. With an open mind, we asked: What if we build a modern successor that does everything imapcopy did, but so much more? Native TLS 1.3, zero-config server auto-discovery, POP3 source support, multi-threading, smart Message-ID deduplication, and a clean GUI. We open-sourced it for everyone, and with the help of the community, our goal is to make this the modern, free go-to tool for email migration."
                                               TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Credits &amp; Authorship" FontWeight="Bold" FontSize="13" Foreground="#60A5FA" Margin="0,0,0,8" />
                                    <TextBlock Text="• Author: Danny Schuller" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />
                                    <TextBlock Text="• Company: Mundofy" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />
                                    <TextBlock FontSize="13" Margin="0,3">
                                        <Run Text="• Website: " Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Hyperlink NavigateUri="https://mundofy.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA">
                                            https://mundofy.com
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Margin="0,3">
                                        <Run Text="• Source Code: " Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Hyperlink NavigateUri="https://github.com/MundofyOfficial/Mundofy-MailMigrator" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA">
                                            github.com/MundofyOfficial/Mundofy-MailMigrator
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Margin="0,3">
                                        <Run Text="• Issue Tracker: " Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Hyperlink NavigateUri="https://github.com/MundofyOfficial/Mundofy-MailMigrator/issues" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA">
                                            github.com/MundofyOfficial/Mundofy-MailMigrator/issues
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="• Inspired by: The classic 'imapcopy' tool originally created by Armin Diehl (2001-2009)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Text="• IMAP / POP3 Engine: Powered by MailKit (Jeffrey Stedfast)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3" />
                                </StackPanel>
                            </Border>

                            <!-- FEEDBACK & ISSUES CARD -->
                            <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Found a Bug or Have a Feature Request?" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="We welcome community feedback! Report issues, ask questions, or contribute directly on GitHub."
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="OpenGitHubIssues_Click" Cursor="Hand" Margin="20,0,0,0" VerticalAlignment="Center"
                                            Padding="16,8" Background="#2563EB" BorderThickness="0" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                        <TextBlock Text="Report an Issue" />
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="Free and open for everyone. Distributed as a standalone portable Windows executable."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
