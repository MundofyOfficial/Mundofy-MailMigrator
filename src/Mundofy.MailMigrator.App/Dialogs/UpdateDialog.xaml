<Window x:Class="Mundofy.MailMigrator.App.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Margin="16"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.75" Direction="270" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAGGABLE) -->
            <Border Grid.Row="0"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="18,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/mundofy_mark_color.png"
                               Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Software Update"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#FFFFFF"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="New Release" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="Cancel_Click"
                            Content="✕"
                            Width="28" Height="28"
                            FontSize="13"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Close (Esc)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. BODY -->
            <StackPanel Grid.Row="1" Margin="24,20">
                <!-- Title Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Rocket Badge -->
                    <Border Grid.Column="0"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="#1E3A8A"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeading"
                                   Text="Update Available: v1.4.1"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text="A newer version of Mundofy MailMigrator is available on GitHub."
                                   FontSize="12" Foreground="#94A3B8"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Versions Card -->
                <Border Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Current Version -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CURRENT VERSION" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="TxtCurrentVersion" Text="v1.4.0" FontSize="15" FontWeight="Bold" Foreground="#94A3B8" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="➔" FontSize="18" Foreground="#60A5FA" VerticalAlignment="Center" Margin="14,0" />

                        <!-- New Version -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LATEST VERSION" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="TxtLatestVersion" Text="v1.4.1" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Release Notes Preview -->
                <TextBlock Text="Release Highlights:" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" MaxHeight="140" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtReleaseNotes"
                                   Text="Release notes here..."
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Download Progress Indicator (Visible only during download) -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtProgressStatus" Text="Downloading update..." FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="12" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="ProgressBar" Height="10" Value="0" Maximum="100" />
                </StackPanel>
            </StackPanel>

            <!-- 3. FOOTER -->
            <Border Grid.Row="2"
                    Background="#141E2F"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Click="Cancel_Click"
                            Content="Remind Me Later"
                            Padding="16,8"
                            FontSize="12.5"
                            Background="#1E293B"
                            BorderBrush="#475569"
                            Foreground="#94A3B8"
                            IsCancel="True" />

                    <Button x:Name="BtnUpdate"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Click="UpdateNow_Click"
                            Content="⚡ Update &amp; Restart Now"
                            Padding="18,8"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Background="#2563EB"
                            BorderBrush="#1D4ED8"
                            Foreground="#FFFFFF"
                            IsDefault="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
