<Window x:Class="Mundofy.MailMigrator.App.Dialogs.ImportAccountsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Accounts - Replace or Append?"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- OUTSIDE CONTAINER WITH DROP SHADOW -->
    <Border Margin="16"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.75" Direction="270" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Body -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER (DRAGGABLE) -->
            <Border Grid.Row="0"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="18,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/mundofy_mark_color.png"
                               Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Import Accounts"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#FFFFFF"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Action Required" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Click="Cancel_Click"
                            Content="✕"
                            Width="28" Height="28"
                            FontSize="13"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Close (Esc)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. MAIN CONTENT BODY -->
            <StackPanel Grid.Row="1" Margin="24,20">
                <!-- Title Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="#1E3A8A"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="📥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Replace or Append Accounts?"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text="Existing accounts were found in your batch table. Choose how to handle the incoming accounts."
                                   FontSize="12" Foreground="#94A3B8"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Accounts Summary Card -->
                <Border Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Current Count -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="CURRENT IN BATCH" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="TxtCurrentCount" Text="4 account(s)" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Vertical Divider -->
                        <Rectangle Grid.Column="1" Fill="#334155" Width="1" />

                        <!-- Incoming Count -->
                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                            <TextBlock Text="INCOMING IMPORT" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="TxtIncomingCount" Text="4 account(s)" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0" />
                            <TextBlock x:Name="TxtSourceDescription" Text="from 'migrated_accounts.csv'" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Explanations -->
                <StackPanel Margin="2,0,0,0">
                    <!-- Option 1: Replace -->
                    <Border Background="#182234" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Replace List" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC" />
                            <TextBlock Text="Clears current batch rows and populates with the newly imported accounts." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Option 2: Append -->
                    <Border Background="#182234" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Append (Add to List)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC" />
                            <TextBlock Text="Preserves all existing accounts and appends the new accounts to the end." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 3. ACTION BUTTONS FOOTER -->
            <Border Grid.Row="2"
                    Background="#141E2F"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cancel button on left -->
                    <Button Grid.Column="0"
                            Click="Cancel_Click"
                            Content="Cancel"
                            Padding="16,8"
                            FontSize="12.5"
                            Background="#1E293B"
                            BorderBrush="#475569"
                            Foreground="#94A3B8"
                            IsCancel="True" />

                    <!-- Action buttons on right -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Append Button (Emerald Green) -->
                        <Button Click="Append_Click"
                                Content="Append to List"
                                Margin="0,0,10,0"
                                Padding="16,8"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Background="#059669"
                                BorderBrush="#047857"
                                Foreground="#FFFFFF">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#10B981" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#047857" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Replace Button (Accent Blue) -->
                        <Button Click="Replace_Click"
                                Content="Replace List"
                                Padding="18,8"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Background="#2563EB"
                                BorderBrush="#1D4ED8"
                                Foreground="#FFFFFF"
                                IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1E40AF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
