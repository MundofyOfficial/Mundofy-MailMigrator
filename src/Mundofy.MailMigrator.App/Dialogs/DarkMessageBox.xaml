<Window x:Class="Mundofy.MailMigrator.App.Dialogs.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Margin="16"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.75" Direction="270" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAGGABLE) -->
            <Border Grid.Row="0"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="16,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/mundofy_mark_color.png"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtTitle"
                                   Text="Notification"
                                   FontWeight="Bold" FontSize="13.5"
                                   Foreground="#FFFFFF"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="Close_Click"
                            Content="✕"
                            Width="26" Height="26"
                            FontSize="12"
                            Foreground="#94A3B8"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Close (Esc)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. BODY -->
            <Grid Grid.Row="1" Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="42" Height="42"
                        CornerRadius="21"
                        Background="#1E3A8A"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="ℹ" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Message text -->
                <TextBlock x:Name="TxtMessage"
                           Grid.Column="1"
                           Text="Message text goes here"
                           FontSize="13"
                           Foreground="#F8FAFC"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 3. BUTTON FOOTER -->
            <Border Grid.Row="2"
                    Background="#141E2F"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Cancel Button -->
                    <Button x:Name="BtnCancel"
                            Click="Cancel_Click"
                            Content="Cancel"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Padding="16,7"
                            FontSize="12.5"
                            Background="#1E293B"
                            BorderBrush="#475569"
                            Foreground="#94A3B8"
                            IsCancel="True" />

                    <!-- No Button -->
                    <Button x:Name="BtnNo"
                            Click="No_Click"
                            Content="No"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Padding="16,7"
                            FontSize="12.5"
                            Background="#334155"
                            BorderBrush="#475569"
                            Foreground="#F8FAFC" />

                    <!-- Yes Button -->
                    <Button x:Name="BtnYes"
                            Click="Yes_Click"
                            Content="Yes"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Padding="18,7"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Background="#2563EB"
                            BorderBrush="#1D4ED8"
                            Foreground="#FFFFFF" />

                    <!-- OK Button -->
                    <Button x:Name="BtnOk"
                            Click="Ok_Click"
                            Content="OK"
                            Visibility="Visible"
                            Padding="22,7"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Background="#2563EB"
                            BorderBrush="#1D4ED8"
                            Foreground="#FFFFFF"
                            IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
